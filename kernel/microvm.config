# From tinyconfig (nearly empty) up — every line earns its place.
# --- run programs at all ---
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MULTIUSER=y
# --- 64-bit + memory + smp basics ---
CONFIG_SMP=y
# CONFIG_ARCH_VIRT is deliberately absent: it is an arm(32) and riscv
# symbol only. arm64's virt machine is pure device tree and needs no
# board option. The spike's config carried the line as a no-op.
# --- console ---
CONFIG_TTY=y
# The PL011 is the KERNEL's own console (`ttyAMA0`), so a boot failure —
# a bad DTB, a missing initramfs, a panic in early init — is visible on the
# host before any virtio device has been probed. It is NOT where the app's
# output goes: the app's stdout is `hvc0`, a virtio-console port, which is a
# different device on a different transport. Both exist on purpose; deleting
# the PL011 to "save a driver" would make every pre-virtio failure silent,
# which is the one failure this runtime cannot afford.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_PRINTK=y
# Every printk gets `[    0.123456]`. Without it a boot log is an unordered
# wall of text and "it hung" cannot be distinguished from "it took 30s".
CONFIG_PRINTK_TIME=y
# --- interrupts + time ---
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_ARCH_TIMER=y
# --- initramfs to hold our init ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_BLK_DEV=y
CONFIG_BLOCK=y
# --- our three virtio devices, built in ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_NETDEVICES=y
# --- filesystems ---
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
# CONFIG_DEVTMPFS_MOUNT is a DOCUMENTED NO-OP for us: drivers/base/Kconfig
# says "This option does not affect initramfs based booting, here the devtmpfs
# filesystem has to be mounted from the initramfs' /init script" — the kernel
# only auto-mounts /dev when it mounts a real root itself. We always boot an
# initramfs, so the guest init mounts /dev itself. Kept because it costs
# nothing and because a future non-initramfs boot would want it; asserted
# below only so nobody "fixes" it by deleting the wrong one of the two lines.
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
# --- networking core (for step 6's eth0) ---
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y

# --- ply additions over the plyvm spike config ---------------------------
# Volumes are ext4 disks (spec: "Volumes as disks, not shared directories").
# The spike found this missing: without it `mkfs.ext4` in the guest init
# succeeds and the mount then fails with ENODEV.
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y

# The control channel is virtio-console port 1 (`hvc1`); the app's stdout is
# port 0 (`hvc0`). HVF has no vsock device, so a second console is how the
# host and guest talk (spec: "Why a control console instead of virtio-vsock").
#
# CAVEAT for Task 8: this config buys `/dev/hvc0` and nothing more. A
# multiport virtio-console port only becomes `/dev/hvcN` if the DEVICE sends
# VIRTIO_CONSOLE_CONSOLE_PORT for it; a port without that control message
# appears as `/dev/vport0p<n>` instead. `hvc1` is the device model's promise,
# not the kernel's — see scripts/microvm-smoke.sh, which reports hvc1 and
# deliberately does not gate on it.
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HVC_DRIVER=y

# The overlay is assembled from N read-only squashfs layers; the spike's
# config already has SQUASHFS + OVERLAY_FS. Zstd is what `ply build` writes.
CONFIG_SQUASHFS_ZSTD=y

# --- parents the fragment above needs, or kconfig drops it silently ------
# `tinyconfig` is `allnoconfig` plus a size fragment, so it turns OFF the
# `menuconfig` umbrellas these options live under. `olddefconfig` then drops
# any child whose parent is off WITHOUT WARNING: the option is simply absent
# from the built .config. Measured on 6.12 — VIRTIO_MMIO, SQUASHFS,
# SQUASHFS_XZ, SQUASHFS_ZSTD and TMPFS were all lost this way, which is what
# the assertion loop at the end of scripts/build-microvm-kernel.sh exists to
# catch. Order inside this file does not matter; presence does.

# drivers/virtio/Kconfig wraps VIRTIO_MMIO in `if VIRTIO_MENU`. VIRTIO_BLK
# and VIRTIO_NET live outside it, which is why only the transport vanished
# and the devices appeared to be fine.
CONFIG_VIRTIO_MENU=y

# fs/Kconfig wraps every squashfs option in `if MISC_FILESYSTEMS`.
CONFIG_MISC_FILESYSTEMS=y

# TMPFS `depends on SHMEM`, and tinyconfig turns SHMEM off. /run/ply, the
# params tree the guest publishes into, is a tmpfs.
CONFIG_SHMEM=y

# =========================================================================
# tinyconfig implies CONFIG_EXPERT=y, and EXPERT deletes the syscall surface
# =========================================================================
# `make tinyconfig` is `make allnoconfig KCONFIG_ALLCONFIG=kernel/configs/
# tiny.config`, and tiny.config contains `CONFIG_SLUB_TINY=y`, which
# `depends on EXPERT`. So asking for a tiny kernel turns CONFIG_EXPERT ON as
# a side effect. That is not a cosmetic difference. About fifteen core
# options are declared upstream in this shape:
#
#     config FUTEX
#             bool "Enable futex support" if EXPERT
#             default y
#
# The prompt EXISTS ONLY WHEN EXPERT IS SET. With EXPERT off there is no
# question to answer, so `allnoconfig` leaves them at `default y`. With
# EXPERT on they become questions, and `allnoconfig` answers `n` to every
# question it is asked. Measured on 6.12/arm64, same tree, same day:
#
#     make allnoconfig -> CONFIG_EXPERT is not set
#                         CONFIG_FUTEX=y CONFIG_EPOLL=y CONFIG_EVENTFD=y
#                         CONFIG_SIGNALFD=y CONFIG_TIMERFD=y
#                         CONFIG_POSIX_TIMERS=y CONFIG_AIO=y ...
#     make tinyconfig  -> CONFIG_EXPERT=y
#                         # CONFIG_FUTEX is not set
#                         # CONFIG_EPOLL is not set        (all seven, and
#                         ...                               60 more besides)
#
# Nothing below is a feature. Each is a syscall that a stock glibc, musl,
# Go runtime or Rust `std` issues without ever asking whether the kernel has
# it, and the failure mode is always the same: ENOSYS deep inside a library,
# an app that exits before it can explain itself, and a kernel build that
# reported no error at all. The 39-assertion loop in the build script passed
# a kernel that could not run PostgreSQL, redis, node, or any Go binary.
#
# Each line therefore carries the reason it is here, because a `default y`
# option written out longhand is exactly what a later editor deletes as
# redundant. It is not redundant: it is only `default y` when EXPERT is off,
# and EXPERT is on.
#
# When bumping the kernel, re-derive this list rather than trusting it:
#     make O=/tmp/a ARCH=arm64 allnoconfig
#     make O=/tmp/b ARCH=arm64 tinyconfig
#     diff /tmp/a/.config /tmp/b/.config     # everything y->n is a candidate

# --- group A: EXPERT-gated, `default y` upstream -------------------------
# glibc's and musl's pthread_mutex_lock, every Rust std::sync primitive, and
# the Go runtime's goroutine parking all become futex(2) the moment a lock is
# contended. Without it a threaded program deadlocks or aborts on ENOSYS.
CONFIG_FUTEX=y
# epoll_create1(2). postgres's WaitEventSet, redis's ae, nginx, and
# node/libuv's entire event loop are epoll. This is the single option whose
# absence stops the most software.
CONFIG_EPOLL=y
# eventfd(2): how libuv, tokio and glibc's AIO wake an epoll loop from
# another thread. Without it those runtimes fail at startup, not at load.
CONFIG_EVENTFD=y
# signalfd(2): the standard way a server turns SIGTERM/SIGCHLD into a
# pollable fd instead of a racy handler. ply sends SIGTERM on `ply down`.
CONFIG_SIGNALFD=y
# timerfd_create(2): pollable timers. libuv's uv_timer, systemd, and most
# Rust/Go timer wheels on Linux.
CONFIG_TIMERFD=y
# timer_create/clock_nanosleep and the whole POSIX timer API. glibc's
# nanosleep, sleep(3) and pthread_cond_timedwait route through this; the JVM
# and .NET use timer_create directly.
CONFIG_POSIX_TIMERS=y
# flock(2) and fcntl(F_SETLK). sqlite's locking protocol, dpkg's frontend
# lock, cargo's package-cache lock, postgres's postmaster.pid. Without it a
# database silently believes it is alone or refuses to start.
CONFIG_FILE_LOCKING=y
# madvise(2)/posix_fadvise(2). glibc's malloc (MADV_DONTNEED), jemalloc,
# Go's heap release and every mmap-based database call these constantly;
# with ADVISE_SYSCALLS off they are ENOSYS and some allocators abort.
CONFIG_ADVISE_SYSCALLS=y
# rseq(2). glibc >= 2.35 REGISTERS RSEQ FOR EVERY THREAD AT STARTUP; the
# failure is tolerated but silently costs the per-CPU fast paths glibc's
# malloc and sched_getcpu depend on. Go 1.21+ probes it too. Cheap; on.
CONFIG_RSEQ=y
# io_setup(2)/io_submit(2). MariaDB's innodb_use_native_aio is ON by
# default and glibc's POSIX AIO thread pool is the fallback nobody tests.
CONFIG_AIO=y
# io_uring. Kept ON deliberately, against the instinct to trim it: modern
# runtimes PROBE for it (PostgreSQL 18's io_method=io_uring, tokio-uring,
# ScyllaDB, recent libuv builds) and the fallback path is the one the app
# author never exercised. This is a single-tenant VM per app, so io_uring's
# usual objection — attack surface shared with other tenants — does not
# apply here. Measured: 65,536 bytes of Image, the only line in this block
# that costs a measurable amount.
CONFIG_IO_URING=y
# membarrier(2). The .NET GC's thread suspension, Java's ZGC/Shenandoah
# handshakes and userspace RCU (liburcu, crossbeam-epoch) use
# MEMBARRIER_CMD_PRIVATE_EXPEDITED; the fallbacks are mprotect tricks that
# are slower and, in .NET's case, historically buggy. ~2 KB.
CONFIG_MEMBARRIER=y
# name_to_handle_at(2)/open_by_handle_at(2). Used to identify a file across
# renames — Java's WatchService, systemd, and several backup tools.
CONFIG_FHANDLE=y

# --- group B: no `default y` at all, so ANY all-no config loses them ------
# These four differ from group A: their prompts are unconditional and they
# have no `default y`, so `allnoconfig` turns them off with or without
# EXPERT. A real defconfig sets them; we start from nothing, so we must.
# shmget(2)/semget(2)/msgget(2). PostgreSQL creates a System V shared
# memory segment ON EVERY START as its "another postmaster is running"
# interlock, even with shared_memory_type=mmap — so postgres does not start
# at all without this. Oracle-lineage and many JVM apps use it too.
CONFIG_SYSVIPC=y
# inotify_init1(2). NOT OPTIONAL FOR PLY: Task 6's guest init watches
# /run/ply/self with inotify to forward the app's self-published keys to the
# host. Without it `publish` never fires and nothing reports an error.
# Also: node --watch, webpack, air, cargo-watch, tail -F, nginx reload.
CONFIG_INOTIFY_USER=y
# seccomp(2)/prctl(PR_SET_SECCOMP). Programs that sandbox THEMSELVES treat
# a failed seccomp install as fatal — sshd's privsep child calls fatal() on
# it, and Chromium/Electron, bubblewrap and container runtimes do the same.
# The app does not get to say why; it just dies.
CONFIG_SECCOMP=y
# The guest wants entropy the instant it boots: getrandom(2) BLOCKS until
# the CRNG is seeded, and a microVM has almost no interrupt jitter to seed
# it with. Apple silicon does not advertise FEAT_RNG, so the arm64
# arch_get_random path gives us nothing either. Driver on, so Task 8 can add
# a virtio-rng device without a kernel rebuild; harmless if no device
# appears. TASK 8: attach one, or expect multi-second stalls in any app that
# reads /dev/random or calls getrandom() early (openssl, node, the JVM).
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# =========================================================================
# xattr support, without which overlayfs fails ORDINARY operations with EIO
# =========================================================================
# The overlay's upper layer is a tmpfs. At mount time overlayfs probes it by
# setting `trusted.overlay.opaque` on the workdir (fs/overlayfs/super.c:697);
# if that fails it sets `ofs->noxattr = true` and carries on mounting. The
# mount SUCCEEDS. Then ovl_set_opaque() -> ovl_check_setxattr(..., xerr) with
# xerr = -EIO (fs/overlayfs/dir.c:248-255, util.c:877-880), so:
#
#   rm -rf /var/lib/foo && mkdir /var/lib/foo      -> EIO
#
# whenever /var/lib/foo also exists in a lower image layer, because the new
# directory has to be marked opaque to hide the lower one. Same lockfile,
# same image, different filesystem semantics from the namespace backend —
# and "mkdir: Input/output error" points at a disk, not at a kernel option.
CONFIG_TMPFS_XATTR=y
# Renaming a directory that came from a lower layer needs a redirect xattr;
# without it ovl_rename() returns -EXDEV, which userspace surfaces as
# "Invalid cross-device link" for a rename INSIDE ONE DIRECTORY. The mount
# option redirect_dir=on could do this instead, but that would put the fix
# in the guest init where a future mount-option edit could drop it. It
# requires TMPFS_XATTR above; with noxattr set, overlayfs silently downgrades
# to redirect_dir=nofollow at mount time.
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
# Image layers are squashfs. Without this, `security.capability` (file
# capabilities — a `ping` or `node` binary that was given CAP_NET_RAW at
# image build time) and `user.*` xattrs are SILENTLY DROPPED when the layer
# is read in the guest, while being present on the same image on Linux.
CONFIG_SQUASHFS_XATTR=y

# =========================================================================
# so that a guest kernel failure can be read
# =========================================================================
# CONFIG_BUG=n compiles BUG()/WARN_ON() down to nothing, so a kernel that
# has already corrupted itself keeps running instead of saying so.
# CONFIG_KALLSYMS=n prints an oops as raw hex addresses with no symbol
# names, and there is no vmlinux next to a user's Mac to resolve them
# against. For a runtime whose entire failure story is "the guest could not
# report", ~200 KB is the cheapest insurance in this file.
CONFIG_BUG=y
CONFIG_DEBUG_BUGVERBOSE=y
CONFIG_KALLSYMS=y
# Measured on 6.12/arm64: these four (with PRINTK_TIME above) are 503,808
# bytes of the 774,144-byte growth this file's rewrite cost -- 5,263,368 ->
# 6,037,512. The entire syscall surface above, plus the xattr block, plus
# seccomp and the rng driver, is the other 270,336. Individually, dropping
# SECCOMP, the three xattr options, or the two HW_RANDOM options changes the
# Image size by ZERO bytes: they fit inside the segment alignment padding
# arm64's linker script already emits.

# --- considered and deliberately left off --------------------------------
# CONFIG_COREDUMP / CONFIG_ELF_CORE — nothing breaks without them (the
#   kernel's default RLIMIT_CORE is 0 anyway) and a core file would land on
#   the overlay upper, i.e. in guest RAM, where it can OOM the VM it is
#   meant to explain.
# CONFIG_NAMESPACES / CONFIG_CGROUPS — one app per VM is the whole point;
#   the VM *is* the namespace. An app that shells out to `unshare` or reads
#   /sys/fs/cgroup for its memory limit will see the VM's limits instead.
# CONFIG_IPV6 — already =y (it is not EXPERT-gated and survives tinyconfig).
# CONFIG_FS_POSIX_ACL / CONFIG_EXT4_FS_SECURITY — no ply image or volume
#   carries ACLs or security.* labels today; revisit if one ever does.
# CONFIG_VM_EVENT_COUNTERS — only fills in /proc/vmstat fields.
# CONFIG_POSIX_MQUEUE, CONFIG_FANOTIFY, CONFIG_KEYS, CONFIG_CHECKPOINT_RESTORE,
# CONFIG_SYSFS_SYSCALL, CONFIG_SECRETMEM, CONFIG_CACHESTAT_SYSCALL — no
#   caller in the software this runtime targets.
